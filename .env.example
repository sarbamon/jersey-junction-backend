PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.2enjcav.mongodb.net/jersey_junction?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=30d
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Hostinger Email Configuration (support@jerseyjunction.shop)
# Hostinger SMTP host is smtp.hostinger.com, port is 465 (SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@jerseyjunction.shop
SMTP_PASS=your_hostinger_email_password_here
SMTP_FROM=support@jerseyjunction.shop
EMAIL_FROM_NAME="Jersey Junction"

# Brevo (Sendinblue) API Configuration
BRAVO_EMAIL_API_KEY=your_brevo_v3_api_key_here
